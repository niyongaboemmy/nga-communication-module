NODE_ENV=development
PORT=5192
# Non-superuser, non-BYPASSRLS role (see apps/api/.env.example, "Database role").
DATABASE_URL=postgres://tupo:tupo@localhost:5432/tupo_dev
JWT_SECRET=change_me_to_a_long_random_secret
CORS_ORIGINS=http://localhost:5194,http://127.0.0.1:5194

# 'local' needs no object store and is the development default.
# 's3' (MinIO or AWS) is the production driver — Phase 2.
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage
MAX_FILE_SIZE_BYTES=5368709120
SIGNED_URL_TTL_SECONDS=900

# ---- Multi-tenancy (MULTI_TENANCY_GAP_FIX_PLAN.md Phase 6) ----
# shadow (default): code with no tenant context acts as tenant 1 and logs once.
# enforce: it fails closed (TenantContextMissing -> 401 TENANT_REQUIRED).
TENANCY_MODE=shadow
# Sessions/tokens without a `tid` claim belong to this tenant; `none` rejects them.
TENANCY_LEGACY_DEFAULT_TID=1
# Tenant registry: MIS GET /platform/tenants/active (SSO Basic credentials, or
# this integration token with scope tenants:read); `local` reads only the
# tenants table. Cached for TENANCY_REGISTRY_TTL_MS.
TENANCY_REGISTRY_SOURCE=mis
# MIS_TENANTS_TOKEN=
# TENANCY_REGISTRY_TTL_MS=30000
# Per-school storage allowance in bytes (per package wins): TENANT_QUOTA_BYTES_STARTER=..., or one for all.
# TENANT_QUOTA_BYTES=
