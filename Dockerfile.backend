FROM node:22-alpine

WORKDIR /app

COPY package*.json tsconfig.base.json ./
COPY packages ./packages
COPY apps ./apps

RUN npm ci

# Workspace packages resolve via their dist/ (see packages/*/package.json main),
# so they must be compiled before any app can import them. Order matters: it is
# the dependency order from the root "build" script.
RUN npm run build -w @tupo/shared \
 && npm run build -w @tupo/db \
 && npm run build -w @tupo/notify \
 && npm run build -w @tupo/chat \
 && npm run build -w @tupo/mail \
 && npm run build -w @tupo/feed

EXPOSE 5190 5191 5192 5193

CMD ["npm", "run", "dev:backend"]
