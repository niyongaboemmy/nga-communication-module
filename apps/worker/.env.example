NODE_ENV=development
PORT=5193
DATABASE_URL=postgres://localhost:5432/tupo_dev
# Queues use Redis db 1; the realtime gateway uses db 0.
REDIS_QUEUE_URL=redis://127.0.0.1:6379/1
# Notifications are published on Redis db 0, same channel as the API.
REDIS_URL=redis://127.0.0.1:6379/0

# ── Mail — SMTP relay (FR-MAIL-7) ─────────────────────────────────────────
# Outbound delivery. Leave SMTP_HOST unset for an internal-only deployment:
# in-app delivery still works, external recipients are recorded as failed.
# In production this is Amazon SES or the institutional relay, with
# SPF/DKIM/DMARC aligned for MAIL_FROM's domain.
# SMTP_HOST=email-smtp.eu-west-1.amazonaws.com
# SMTP_PORT=587
# SMTP_SECURE=false        # true for implicit TLS (port 465)
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="NGA Tupo <no-reply@amashuri.com>"

# Also deliver mail addressed to a Tupo user as a real email, on top of the
# in-app copy (relaxes FR-MAIL-9). Needs a relay above. Users can opt out per
# account in mail settings. Must be set identically for the API — see
# apps/api/.env.example.
# MAIL_INTERNAL_EMAIL=on
