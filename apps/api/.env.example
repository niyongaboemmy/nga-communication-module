# Tupo API — copy to .env and fill in. NEVER commit the real .env.
NODE_ENV=development
PORT=5190

DATABASE_URL=postgres://localhost:5432/tupo_dev

# NGA Central MIS — the sole identity provider for this app.
NGA_MIS_BASE_URL=https://mis.amashuri.com
SSO_CLIENT_ID=tupo
SSO_CLIENT_SECRET=replace_with_real_client_secret

# Signs Tupo's own session JWTs. Must be long and random in production.
JWT_SECRET=change_me_to_a_long_random_secret
SESSION_TTL=24h

CORS_ORIGINS=http://localhost:5194,http://127.0.0.1:5194

# Elevate already-MIS-authenticated accounts to Tupo admin. Not a login path.
# ADMIN_USERNAMES=levi
# ADMIN_EMAILS=owner@amashuri.com

# ── Meet ──────────────────────────────────────────────────────────────────
# All optional. With none of it set, Meet still works: meetings run on the
# peer-to-peer transport with Google STUN, capped at 4 participants.

# Cloudflare Realtime TURN — the same integration TaskMentor's proctoring
# module uses. Without TURN, WebRTC fails on any network that blocks UDP,
# which describes most school networks. 1,000 GB/month free.
CLOUDFLARE_TURN_TOKEN_ID=
CLOUDFLARE_TURN_API_TOKEN=

# ── The media server ──────────────────────────────────────────────────────
# Cloudflare Realtime SFU. This is what lifts a meeting past 4 people, and
# there is nothing to run for it: no container, no UDP port range, no TURN
# companion — it is the same account as the TURN credentials above, and TURN is
# free when used alongside it.
#
#   Cloudflare dashboard → Realtime → SFU → Create app
#   Copy the App ID and the App Secret below. The secret NEVER reaches the
#   browser: every call is proxied through /api/meet/:id/sfu.
#
# Without these two values meetings fall back to peer-to-peer, capped at 4.
CLOUDFLARE_REALTIME_APP_ID=
CLOUDFLARE_REALTIME_APP_SECRET=

# AI provider fallback — the notetaker, summaries, minutes, action items,
# decisions, chapters, Q&A, lesson follow-up and caption translation all go
# through this one chain, ported from TaskMentor. Providers are tried
# left-to-right and fall through automatically on error or quota.
AI_PROVIDER_ORDER=openai,gemini,groq,glm
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GLM_API_KEY=
GLM_MODEL=glm-4.5-flash

# Where the worker calls back to generate post-meeting minutes.
API_INTERNAL_URL=http://127.0.0.1:5190
REDIS_QUEUE_URL=redis://127.0.0.1:6379/1
