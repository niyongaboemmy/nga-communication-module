# Where users are sent to authenticate. Tupo has no login page of its own.
VITE_MIS_LOGIN_URL=https://mis.amashuri.com/login
# Must match the API's SSO_CLIENT_ID.
VITE_SSO_CLIENT_ID=tupo_dev
# Sibling apps for the waffle switcher.
VITE_MIS_HOME_URL=https://mis.amashuri.com
VITE_TASKMENTOR_HOME_URL=https://taskmentor.amashuri.com

# Origin of the realtime Socket.IO gateway. Leave unset for same-origin (the
# dev server proxies /socket.io). Production serves the gateway from its own
# subdomain, so WebSocket traffic does not share a server block with the SPA:
#   VITE_SOCKET_URL=https://tupo-live.amashuri.com
# Whatever origin the app is served from must appear in the gateway's
# CORS_ORIGINS, since the handshake is then cross-origin.
VITE_SOCKET_URL=
