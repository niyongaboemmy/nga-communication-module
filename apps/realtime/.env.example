NODE_ENV=development
PORT=5191
REDIS_URL=redis://127.0.0.1:6379/0
# MUST be byte-identical to the API's JWT_SECRET — this gateway verifies the
# very same session token the API issues.
JWT_SECRET=change_me_to_a_long_random_secret
CORS_ORIGINS=http://localhost:5194,http://127.0.0.1:5194

# The /meet namespace writes captions, chat and participant state directly.
# Same database as the API.
DATABASE_URL=postgres://localhost:5432/tupo_dev

# ── Platform usage analytics ──────────────────────────────────────────────
# Chat messages sent over the socket are counted (tupo.chat.send, no content)
# and forwarded to the MIS. Same three values as apps/api/.env; with any of
# them missing, nothing is recorded.
NGA_MIS_BASE_URL=http://localhost:5001
SSO_CLIENT_ID=tupo
SSO_CLIENT_SECRET=local-dev-secret-tupo
