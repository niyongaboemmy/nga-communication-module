# Tupo API — copy to .env and fill in. NEVER commit the real .env.
NODE_ENV=development
PORT=5190

DATABASE_URL=postgres://localhost:5432/tupo_dev

# ── NGA Central MIS: the only place anyone signs in ──
# start.bat runs a private copy of the Central MIS on this machine (its
# `npm run db:setup` seeds the admin login and registers this client with the
# secret below). These values only exist in that local database, so they are
# safe to commit and there is nothing to paste. The production client and its
# secret live in GitHub Actions and are never in this repo.
NGA_MIS_BASE_URL=http://localhost:5001
SSO_CLIENT_ID=tupo
SSO_CLIENT_SECRET=local-dev-secret-tupo

# Signs Tupo's own session JWTs. Must be long and random in production.
JWT_SECRET=change_me_to_a_long_random_secret
SESSION_TTL=24h

CORS_ORIGINS=http://localhost:5194,http://127.0.0.1:5194

# Elevate already-MIS-authenticated accounts to Tupo admin. Not a login path.
# ADMIN_USERNAMES=levi
# ADMIN_EMAILS=owner@amashuri.com

# ── Meet ──────────────────────────────────────────────────────────────────
# All optional. With none of it set, Meet still works: meetings run on the
# peer-to-peer transport with Google STUN, capped at 4 participants.

# Cloudflare Realtime TURN — the same integration TaskMentor's proctoring
# module uses. Without TURN, WebRTC fails on any network that blocks UDP,
# which describes most school networks. 1,000 GB/month free.
CLOUDFLARE_TURN_TOKEN_ID=
CLOUDFLARE_TURN_API_TOKEN=

# ── The media server ──────────────────────────────────────────────────────
# Cloudflare Realtime SFU. This is what lifts a meeting past 4 people, and
# there is nothing to run for it: no container, no UDP port range, no TURN
# companion — it is the same account as the TURN credentials above, and TURN is
# free when used alongside it.
#
#   Cloudflare dashboard → Realtime → SFU → Create app
#   Copy the App ID and the App Secret below. The secret NEVER reaches the
#   browser: every call is proxied through /api/meet/:id/sfu.
#
# Without these two values meetings fall back to peer-to-peer, capped at 4.
CLOUDFLARE_REALTIME_APP_ID=
CLOUDFLARE_REALTIME_APP_SECRET=

# AI provider fallback — the notetaker, summaries, minutes, action items,
# decisions, chapters, Q&A, lesson follow-up and caption translation all go
# through this one chain, ported from TaskMentor. Providers are tried
# left-to-right and fall through automatically on error or quota.
AI_PROVIDER_ORDER=openai,gemini,groq,deepseek,openrouter,glm
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GLM_API_KEY=
GLM_MODEL=glm-4.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# OpenRouter (https://openrouter.ai/keys): FREE models only. Comma-separated fallback list; ids
# without ":free" (other than openrouter/free) are ignored. 50 requests/day per account without credits.
OPENROUTER_API_KEY=
OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,openrouter/free

# Where the worker calls back to generate post-meeting minutes.
API_INTERNAL_URL=http://127.0.0.1:5190
REDIS_QUEUE_URL=redis://127.0.0.1:6379/1

# ── Mail ──────────────────────────────────────────────────────────────────
# Also deliver mail addressed to a Tupo user as a real email (on top of the
# in-app copy). Must match apps/worker/.env, which holds the SMTP relay and
# actually sends. Users can opt out per account in mail settings.
# MAIL_INTERNAL_EMAIL=on

# ── Meeting reminders (MIS Reminder Hub) ──────────────────────────────────
# Scheduled meetings are pushed to {NGA_MIS_BASE_URL}/reminders/sources so
# invitees get Web Push / in-app / calendar reminders. Authenticated with the
# SSO_CLIENT_ID / SSO_CLIENT_SECRET above — no extra secret. On by default
# whenever those are set (never under NODE_ENV=test); set to false to stop.
# REMINDERS_SYNC=false
# Public origin of the web app, for the join link in each reminder. Defaults
# to the first CORS_ORIGINS entry. Production: https://tupo.amashuri.com
# APP_PUBLIC_URL=http://localhost:5194

# ── Platform usage analytics (MIS Usage & Monitoring) ─────────────────────
# The browser posts page views/heartbeats to POST /api/activity; this API
# forwards them to {NGA_MIS_BASE_URL}/activity/ingest with the SSO_CLIENT_ID /
# SSO_CLIENT_SECRET above (that client id must be in the MIS's
# ACTIVITY_SOURCE_CLIENTS). On whenever those three are set, never under
# NODE_ENV=test. SPA origins allowed to send anonymous (public-page) batches:
# ACTIVITY_ORIGINS=https://tupo.amashuri.com,http://localhost:5194,http://127.0.0.1:5194
