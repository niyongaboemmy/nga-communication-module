# Tupo API — copy to .env and fill in. NEVER commit the real .env.
NODE_ENV=development
PORT=5190

DATABASE_URL=postgres://localhost:5432/tupo_dev

# NGA Central MIS — the sole identity provider for this app.
NGA_MIS_BASE_URL=https://mis.amashuri.com
SSO_CLIENT_ID=tupo
SSO_CLIENT_SECRET=replace_with_real_client_secret

# Signs Tupo's own session JWTs. Must be long and random in production.
JWT_SECRET=change_me_to_a_long_random_secret
SESSION_TTL=24h

CORS_ORIGINS=http://localhost:5194,http://127.0.0.1:5194

# Elevate already-MIS-authenticated accounts to Tupo admin. Not a login path.
# ADMIN_USERNAMES=levi
# ADMIN_EMAILS=owner@amashuri.com
